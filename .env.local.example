# Server
PORT=3000
HOST=localhost

# Public base URL used when building package access URLs returned by MCP tools
# Should be the externally-reachable origin (e.g. https://talonpress.example.com)
PUBLIC_BASE_URL=http://localhost:3000

# Storage path — defaults to ./.storage relative to cwd if left blank
STORAGE_DIR_PATH=

# Optional: set to enable auth gating on management views and the MCP endpoint.
# When set, the /auth page and session cookies are activated. This is the machine
# credential — MCP clients and CLI automation send it as `Authorization: Bearer <secret>`.
TALONPRESS_SHARED_SECRET=

# Session cookie TTL in seconds (default: 3600 = 1 hour)
AUTH_SESSION_TTL=3600

# --- authz-proxy (reverse proxy mode) -------------------------------------
# Base URL of the authz-proxy deployment in front of TalonPress. When set, the
# user's name and roles are read from the RS256 JWT the proxy forwards in
# X-Auth-Request-JWT, verified against $AUTHZ_PROXY_URL/.well-known/jwks.json.
# The proxy must run with JWT_ASYMMETRIC_SIGNING=true.
AUTHZ_PROXY_URL=

# External role that grants TalonPress management access (default: talonpress-admin)
TALONPRESS_ADMIN_ROLE=talonpress-admin

# 'jwt' (default) verifies the forwarded token cryptographically.
# 'header' trusts X-Auth-Request-Email / -Role-List verbatim and needs no JWKS —
# only safe when the proxy is the sole ingress and strips client-sent copies of
# those headers. Note that 'header' mode carries no display name, only the email.
AUTHZ_ROLE_SOURCE=jwt

# Set to 1 to trace SDK token resolution to stderr (never logs the token itself)
AUTHZ_PROXY_DEBUG=

# --- MCP transport auth ---------------------------------------------------
# 'inherit' (default) gates /api/mcp with whatever auth is configured above.
# 'none' opts the MCP transport out entirely — for clusters where MCP clients
# reach the pod over an internal Service that never passes through authz-proxy.
# Only set this when every non-cluster route to the pod terminates at the proxy;
# anything able to reach the pod port directly can then publish/delete packages.
TALONPRESS_MCP_AUTH=inherit

# Set to "true" to suppress the "Authentication disabled" warning banner.
# Use this when you provide your own auth/security layer upstream (e.g. a reverse proxy).
TALONPRESS_DISABLE_AUTH_WARNING=

# --- OpenTalon agent chat -------------------------------------------------
# Puts a chat bubble on served package pages so an admin can talk to an agent
# about the package they are reading. TalonPress proxies: the browser talks to
# TalonPress with its own session, TalonPress talks to OpenTalon with the secret
# below. OpenTalon is never browser-facing and the secret never leaves the server.
#
# Requires auth to be configured (shared secret or authz-proxy). With neither,
# every anonymous caller counts as an admin, so the chat stays off.
# Base URL of the OpenTalon deployment, without /api/embed.
TALONPRESS_AGENT_URL=

# Must match embed.clients[talonpress].secret in OpenTalon's secrets.yaml.
TALONPRESS_AGENT_SECRET=

# Timeout for non-streaming calls to OpenTalon, in ms (default: 15000).
# Does not apply to the SSE relay, which stays open for the life of the turn.
TALONPRESS_AGENT_TIMEOUT_MS=15000

# Budget for the rendered page-context block, in characters (default: 4000).
# Keep at or below OpenTalon's own maxContextChars for this client.
TALONPRESS_AGENT_MAX_CONTEXT_CHARS=4000
